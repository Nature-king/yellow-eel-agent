# ===============================
# Qwen / DashScope 配置
# ===============================

# 阿里云百炼 API Key
DASHSCOPE_API_KEY="输入你的API Key"


# Qwen模型名称
# 可选:
# qwen-plus
# qwen-max
# qwen-turbo
QWEN_MODEL=qwen3.7-flash-2026-07-15


# ===============================
# MySQL数据库配置
# ===============================

MYSQL_USER=数据库用户名

MYSQL_PASSWORD=数据库密码

MYSQL_HOST=localhost

MYSQL_PORT=3306

MYSQL_DATABASE=yellow_eel_agent



# ===============================
# Agent配置
# ===============================

# Agent温度
# 越低越稳定
TEMPERATURE=0.2


# 最大Agent循环次数
MAX_ITERATIONS=10



# ===============================
# 项目配置
# ===============================

PROJECT_NAME=yellow_eel_agent

ENVIRONMENT=development